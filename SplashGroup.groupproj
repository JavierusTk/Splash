<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{C7386555-6BE6-4DBB-BAC3-1F236DA3097C}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="SplashScreen.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Test.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="TestAuto.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="SplashScreen">
        <MSBuild Projects="SplashScreen.dproj"/>
    </Target>
    <Target Name="SplashScreen:Clean">
        <MSBuild Projects="SplashScreen.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SplashScreen:Make">
        <MSBuild Projects="SplashScreen.dproj" Targets="Make"/>
    </Target>
    <Target Name="Test">
        <MSBuild Projects="Test.dproj"/>
    </Target>
    <Target Name="Test:Clean">
        <MSBuild Projects="Test.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Test:Make">
        <MSBuild Projects="Test.dproj" Targets="Make"/>
    </Target>
    <Target Name="TestAuto">
        <MSBuild Projects="TestAuto.dproj"/>
    </Target>
    <Target Name="TestAuto:Clean">
        <MSBuild Projects="TestAuto.dproj" Targets="Clean"/>
    </Target>
    <Target Name="TestAuto:Make">
        <MSBuild Projects="TestAuto.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="SplashScreen;Test;TestAuto"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="SplashScreen:Clean;Test:Clean;TestAuto:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="SplashScreen:Make;Test:Make;TestAuto:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
